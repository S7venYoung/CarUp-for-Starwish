diff --git a/common/src/main/java/com/shilapi/xcertplay/SilentWirelessSession.kt b/common/src/main/java/com/shilapi/xcertplay/SilentWirelessSession.kt
new file mode 100644
index 0000000..5579aa3
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/SilentWirelessSession.kt
@@ -0,0 +1,89 @@
+package com.shilapi.xcertplay
+
+import android.content.Context
+import android.content.Intent
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import androidx.core.content.ContextCompat
+import com.shilapi.xcertplay.airplay.*
+import com.shilapi.xcertplay.media.AndroidMediaSink
+import com.shilapi.xcertplay.orchestration.*
+import com.shilapi.xcertplay.transport.Iap2IdentificationConfig
+
+/** Starwish main-screen experiment. The first Activity adopts this exact controller and sink. */
+internal object SilentWirelessSession {
+    const val ACTION = "com.starwish.diplay.SILENT_WIRELESS"
+    private val handler = Handler(Looper.getMainLooper())
+
+    fun request(context: Context) {
+        if (CarPlayBackgroundSession.hasSession()) return
+        ContextCompat.startForegroundService(context,
+            Intent(context, DiPlaySessionService::class.java).setAction(ACTION))
+    }
+
+    fun start(service: DiPlaySessionService) {
+        if (CarPlayBackgroundSession.hasSession()) return
+        val prefs = AirPlayPersistence
+        val target = prefs.loadMfiTarget(service)
+        require(target == MfiTarget.LOCAL) { "Configure local authentication first" }
+        DiPlayBootstrap.ensure(service, target)
+        val identity = prefs.loadIdentity(service)
+        val id = DiPlayBootstrap.deviceId(identity)
+        val compact = id.replace(":", "")
+        val runtime = CarPlayRuntimeConfig(
+            transport = CarPlayTransport.WIRELESS, mfiTarget = target, label = "DiPlay",
+            hostName = "diplay-" + compact.lowercase(),
+            hostMac = id.split(":").map { it.toInt(16).toByte() }.toByteArray(),
+            identification = Iap2IdentificationConfig("DiPlay", "Starwish", "Geely", "DIPLAY-" + compact, "0.1.0", "1.0", 3),
+            wirelessBluetoothDeviceAddress = DiPlayPreferences.phoneAddress(service),
+            wirelessHotspotMode = prefs.loadWirelessHotspotMode(service),
+            manualHotspotSsid = prefs.loadManualHotspotSsid(service),
+            manualHotspotPassphrase = prefs.loadManualHotspotPassphrase(service),
+            manualHotspotBand = prefs.loadManualHotspotBand(service),
+            manualHotspotChannel = prefs.loadManualHotspotChannel(service),
+            manualHotspotSecurity = prefs.loadManualHotspotSecurity(service),
+            manualHotspotInterface = prefs.loadManualHotspotInterface(service).ifBlank { null },
+            existingWifiSsid = prefs.loadExistingWifiSsid(service),
+            existingWifiPassphrase = prefs.loadExistingWifiPassphrase(service),
+            existingWifiInterface = prefs.loadExistingWifiInterface(service).ifBlank { null },
+            wifiP2pPreferredChannel = prefs.loadWifiP2pPreferredChannel(service))
+        val width = 1920
+        val height = 968
+        val config = AirPlayConfig("DiPlay", id, DiPlayBluetooth.localAddress(service) ?: id,
+            "950.7.1", AirPlayDisplayConfig(width, height, fps = 30))
+        val sink = AndroidMediaSink(context = service.applicationContext, videoWidth = width, videoHeight = height)
+        val owner = Any()
+        fun stopIfOwned() {
+            handler.post { if (CarPlayBackgroundSession.isOwner(owner)) CarPlayBackgroundSession.stop() }
+        }
+        val controller = CarPlayController(service, runtime, config, identity,
+            prefs.loadPairings(service) { peer, key -> prefs.savePairing(service, peer, key) },
+            object : AirPlaySessionListener {
+                override fun onSessionActive(session: AirPlaySession) {
+                    if (CarPlayBackgroundSession.isOwner(owner)) CarPlayBackgroundSession.active = true
+                }
+                override fun onSessionEnded(session: AirPlaySession) = stopIfOwned()
+            }, CarPlayMediaEngine(sink), { status -> Log.i("StarwishSilent", status.javaClass.simpleName) })
+        val timeout = Runnable {
+            if (CarPlayBackgroundSession.isOwner(owner) && !CarPlayBackgroundSession.active) stopIfOwned()
+        }
+        CarPlayBackgroundSession.store(controller, sink, width, height, owner,
+            CarPlaySessionDisplay(width, height, 0, true, false, width, height)) { complete ->
+            handler.removeCallbacks(timeout)
+            Thread {
+                try { controller.close() } finally {
+                    handler.post {
+                        try { sink.close() } finally {
+                            CarPlayBackgroundSession.clear(controller)
+                            service.stopSelf()
+                            complete()
+                        }
+                    }
+                }
+            }.start()
+        }
+        handler.postDelayed(timeout, 120_000)
+        try { controller.start() } catch (error: RuntimeException) { stopIfOwned(); throw error }
+    }
+}
